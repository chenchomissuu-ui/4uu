local function applyCorner(inst, radiusPx)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radiusPx or 8)
	c.Parent = inst
	return c
end

local function applyStroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Accent
	s.Thickness = thickness or 1.5
	s.Transparency = transparency or 0
	s.Parent = inst
	return s
end

-- Borde exterior con brillo animado (cian -> morado -> cian), como el
-- contorno neón de la referencia.
local function applyGlowStroke(inst, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2
	s.Parent = inst

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Cyan),
		ColorSequenceKeypoint.new(0.5, Theme.Accent),
		ColorSequenceKeypoint.new(1, Theme.Cyan),
	})
	gradient.Parent = s

	task.spawn(function()
		while inst.Parent do
			gradient.Rotation = (gradient.Rotation + 1) % 360
			task.wait(0.03)
		end
	end)

	return s
end

local function buttonVariantColors(variant)
	if variant == "primary" then
		return Theme.Accent, Color3.fromRGB(220, 180, 255)
	elseif variant == "success" then
		return Theme.Success, Color3.fromRGB(190, 255, 215)
	elseif variant == "danger" then
		return Color3.fromRGB(45, 22, 30), Theme.Danger
	end
	return Theme.RowAlt, Theme.Accent
end

local function setButtonVariant(btn, variant)
	local baseColor, strokeColor = buttonVariantColors(variant)
	btn.BackgroundColor3 = baseColor
	btn:SetAttribute("BaseColor", baseColor)
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = strokeColor
	end
	return baseColor
end

local function styleButton(btn, variant)
	variant = variant or "secondary"

	btn.Font = Theme.FontRegular
	btn.TextColor3 = Theme.Text
	btn.TextScaled = false
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	applyCorner(btn, 7)
	applyStroke(btn, Theme.Accent, 1.3)

	setButtonVariant(btn, variant)

	local originalSize = btn.Size

	btn.MouseEnter:Connect(function()
		local hoverColor = btn.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.12)
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = hoverColor}):Play()
	end)
	btn.MouseLeave:Connect(function()
		local restColor = btn:GetAttribute("BaseColor") or btn.BackgroundColor3
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = restColor}):Play()
		TweenService:Create(btn, TweenInfo.new(0.1), {Size = originalSize}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.07), {
			Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 4, originalSize.Y.Scale, originalSize.Y.Offset - 4)
		}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {Size = originalSize}):Play()
	end)
end

local function styleFrame(frame, bgColor)
	frame.BackgroundColor3 = bgColor or Theme.Panel
	frame.BorderSizePixel = 0
	applyCorner(frame, 12)
end

local function styleLabel(label, big)
	label.Font = big and Theme.Font or Theme.FontRegular
	label.TextColor3 = Theme.Text
	label.TextSize = big and 18 or 14
	label.TextTruncate = Enum.TextTruncate.AtEnd
end

local function styleTextBox(box)
	box.Font = Theme.FontRegular
	box.TextColor3 = Theme.Text
	box.PlaceholderColor3 = Theme.SubText
	box.BackgroundColor3 = Theme.RowAlt
	box.BorderSizePixel = 0
	box.TextSize = 14
	box.TextTruncate = Enum.TextTruncate.AtEnd
	box.ClearTextOnFocus = false
	applyCorner(box, 6)
	applyStroke(box, Theme.Accent, 1)
end

