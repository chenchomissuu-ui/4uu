-- ============================================================
-- TOOL BRIDGE
-- Conecta el sistema de macros con las acciones reales del juego:
-- Azure (ContextActionService+Remote), equipar por número de hotbar,
-- y ataque genérico universal (click/touch/gatillo).
--
-- Corre en su propio hilo (task.spawn) para no bloquear la UI de
-- arriba mientras espera a que el personaje cargue — antes esto
-- corría en un LocalScript aparte (MacroToolBridge), en paralelo.
-- ============================================================

task.spawn(function()
	if not player.Character then
		player.CharacterAdded:Wait()
	end

	local suppressCapture = false
	local currentEquippedTool = nil
	local activatedConnection = nil

	-- ===== AZURE (caso especial: ContextActionService + Remote) =====

	local azureEquipped = false
	local azureRemote = nil

	local function hookAzure(tool)
		if tool.Name ~= "Azure" then return end

		local ToolRemote = tool:WaitForChild("Remote", 5)
		if not ToolRemote then return end

		azureRemote = ToolRemote

		ActionRegistry.Register("Azure_Primary", function(plr, fromInput)
			if fromInput then return end
			ToolRemote:FireServer(Enum.KeyCode.E)
		end)
		ActionRegistry.Register("Azure_Secondary", function(plr, fromInput)
			if fromInput then return end
			ToolRemote:FireServer(Enum.KeyCode.X)
		end)

		tool.Equipped:Connect(function()
			azureEquipped = true
		end)
		tool.Unequipped:Connect(function()
			azureEquipped = false
		end)

		if tool.Parent and tool.Parent:IsA("Model") and tool.Parent == player.Character then
			azureEquipped = true
		end
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not azureEquipped then return end

		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
			ActionRegistry.Execute("Azure_Primary", player, true)
		elseif input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.ButtonY then
			ActionRegistry.Execute("Azure_Secondary", player, true)
		end
	end)

	-- ===== EQUIPAR ARMAS (universal: números en PC, toque en mobile, gamepad) =====

	local function assignHotbarSlots()
		-- No usamos el índice de GetChildren() porque Backpack puede tener
		-- objetos que no son Tools. Solo contamos Tools.
		local currentBackpack = player.Backpack
		local used = {}
		for _, tool in ipairs(currentBackpack:GetChildren()) do
			if tool:IsA("Tool") then
				local slot = tool:GetAttribute("HotbarSlot")
				if typeof(slot) == "number" and slot >= 0 and slot <= 9 then
					used[slot] = true
				end
			end
		end

		local nextSlot = 1
		for _, tool in ipairs(currentBackpack:GetChildren()) do
			if tool:IsA("Tool") and tool:GetAttribute("HotbarSlot") == nil then
				while nextSlot <= 9 and used[nextSlot] do
					nextSlot += 1
				end
				if nextSlot <= 9 then
					tool:SetAttribute("HotbarSlot", nextSlot)
					used[nextSlot] = true
					nextSlot += 1
				end
			end
		end
	end

	task.wait(2)
	assignHotbarSlots()

	local function getToolInSlot(slotNumber: number)
		local currentBackpack = player.Backpack
		for _, tool in ipairs(currentBackpack:GetChildren()) do
			if tool:IsA("Tool") and tool:GetAttribute("HotbarSlot") == slotNumber then
				return tool
			end
		end
		local character = player.Character
		if character then
			for _, tool in ipairs(character:GetChildren()) do
				if tool:IsA("Tool") and tool:GetAttribute("HotbarSlot") == slotNumber then
					return tool
				end
			end
		end
		return nil
	end

	-- Identificación por nombre real de Tool.
	-- Esto NO depende del orden del Backpack ni de un atributo inventado
	-- por este script, por lo que funciona también con hotbars custom.
	local function makeToolActionName(toolName: string): string
		return "EquipTool:" .. toolName
	end

	local function findToolByName(toolName: string)
		local character = player.Character
		if character then
			local equipped = character:FindFirstChild(toolName)
			if equipped and equipped:IsA("Tool") then
				return equipped
			end
		end

		local currentBackpack = player.Backpack
		local tool = currentBackpack:FindFirstChild(toolName)
		if tool and tool:IsA("Tool") then
			return tool
		end

		-- Fallback por si hay nombres duplicados o la Tool está en otro
		-- contenedor del personaje.
		if character then
			for _, child in ipairs(character:GetChildren()) do
				if child:IsA("Tool") and child.Name == toolName then
					return child
				end
			end
		end
		for _, child in ipairs(currentBackpack:GetChildren()) do
			if child:IsA("Tool") and child.Name == toolName then
				return child
			end
		end

		return nil
	end

	local registeredToolActions = {}

	local function registerToolAction(tool: Tool)
		if not tool or not tool:IsA("Tool") then return end

		local actionName = makeToolActionName(tool.Name)
		if registeredToolActions[actionName] then return end
		registeredToolActions[actionName] = true

		ActionRegistry.Register(actionName, function(plr, fromInput)
			-- Cuando viene de la captura solo registramos la acción;
			-- no intentamos equiparla otra vez.
			if fromInput then return end

			local target = findToolByName(tool.Name)
			if not target then return end

			local character = plr.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			suppressCapture = true
			if target.Parent == character then
				humanoid:UnequipTools()
			else
				humanoid:EquipTool(target)
			end
			suppressCapture = false
		end)
	end

	for slotNumber = 0, 9 do
		local actionName = "EquipSlot" .. slotNumber
		ActionRegistry.Register(actionName, function(plr, fromInput)
			if fromInput then return end

			local character = plr.Character
			if not character then return end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			local tool = getToolInSlot(slotNumber)
			if not tool or not tool:IsA("Tool") then return end

			suppressCapture = true
			if tool.Parent == character then
				humanoid:UnequipTools()
			else
				humanoid:EquipTool(tool)
			end
			suppressCapture = false
		end)
	end

	-- ===== ATAQUE GENÉRICO (universal: click en PC, toque en mobile, gatillo en gamepad) =====

	ActionRegistry.Register("ToolAttack", function(plr, fromInput)
		if fromInput then return end

		-- Se busca la herramienta equipada en vivo (en vez de usar solo
		-- currentEquippedTool, que se actualiza vía el evento Equipped y
		-- puede llegar un instante tarde). Esto evita que, al reproducir
		-- una macro que equipa y clickea muy rápido seguido, el click
		-- se pierda porque currentEquippedTool todavía no se había
		-- actualizado en ese momento.
		local character = plr.Character
		local liveTool = character and character:FindFirstChildOfClass("Tool")
		local tool = liveTool or currentEquippedTool

		if tool then
			suppressCapture = true
			tool:Activate()
			suppressCapture = false
		end
	end)

	-- ===== SEGUIMIENTO UNIVERSAL DE CUALQUIER HERRAMIENTA =====

	local function onToolEquipped(tool)
		currentEquippedTool = tool
		registerToolAction(tool)

		-- La acción grabada identifica la Tool por su nombre real.
		-- Ya no depende de que el juego use el mismo orden de slots
		-- que Backpack:GetChildren().
		if not suppressCapture then
			ActionRegistry.Execute(makeToolActionName(tool.Name), player, true)
		end

		if activatedConnection then
			activatedConnection:Disconnect()
		end
		activatedConnection = tool.Activated:Connect(function()
			if not suppressCapture then
				ActionRegistry.Execute("ToolAttack", player, true)
			end
		end)
	end

	local function onToolUnequipped(tool)
		if currentEquippedTool == tool then
			currentEquippedTool = nil
		end
		if activatedConnection then
			activatedConnection:Disconnect()
			activatedConnection = nil
		end

		-- No grabamos una segunda acción al desequipar.
		-- La acción importante es la Tool que el jugador acaba de equipar.
	end

	local trackedTools = {}

	local function trackTool(tool)
		if not tool:IsA("Tool") then return end
		if trackedTools[tool] then return end
		trackedTools[tool] = true

		registerToolAction(tool)
		hookAzure(tool)
		tool.Equipped:Connect(function()
			onToolEquipped(tool)
		end)
		tool.Unequipped:Connect(function()
			onToolUnequipped(tool)
		end)
	end

	local function watchContainer(container)
		for _, tool in ipairs(container:GetChildren()) do
			trackTool(tool)
		end
		container.ChildAdded:Connect(function(child)
			trackTool(child)
		end)
	end

	watchContainer(player:WaitForChild("Backpack"))
	if player.Character then
		watchContainer(player.Character)
	end
	player.CharacterAdded:Connect(function(char)
		watchContainer(char)
		watchContainer(player:WaitForChild("Backpack"))
		task.wait(2)
		assignHotbarSlots()
	end)
end)
