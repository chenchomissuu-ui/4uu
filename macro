	applyCorner(quickButton, 32)
	applyStroke(quickButton, Theme.Accent, 2)

	quickButton.MouseButton1Down:Connect(function()
		TweenService:Create(quickButton, TweenInfo.new(0.08), {Size = UDim2.new(0, 56, 0, 56)}):Play()
	end)
	quickButton.MouseButton1Up:Connect(function()
		TweenService:Create(quickButton, TweenInfo.new(0.1), {Size = UDim2.new(0, 64, 0, 64)}):Play()
	end)

	quickButton.MouseButton1Click:Connect(function()
		if #macro.sequence == 0 then return end
		if macroPlayerInstance:IsPlaying() then return end

		local pulse = TweenService:Create(quickButton, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent})
		pulse:Play()
		task.delay(0.2, function()
			TweenService:Create(quickButton, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Panel}):Play()
		end)

		task.spawn(function()
			macroPlayerInstance:Play(macro, player)
		end)
	end)

	quickButtons[macro.name] = quickButton
end

