local panelTargetSize = MainFrame.Size
local panelClosedSize = UDim2.new(panelTargetSize.X.Scale, panelTargetSize.X.Offset, 0, 0)
MainFrame.Size = panelClosedSize
MainFrame.Visible = false

local panelOpen = false
local function togglePanel()
	panelOpen = not panelOpen
	if panelOpen then
		MainFrame.Visible = true
		MainFrame.Size = panelClosedSize
		TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = panelTargetSize}):Play()
	else
		local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = panelClosedSize})
		tween:Play()
		tween.Completed:Connect(function()
			if not panelOpen then
				MainFrame.Visible = false
			end
		end)
	end
	if UserInputService.GamepadEnabled then
		if panelOpen then
			GuiService.SelectedObject = NewMacroButton
		else
			-- IMPORTANTE: se deja en nil (no en ToggleButton) al cerrar.
			-- Si dejamos algo seleccionado, Roblox intercepta el botón de
			-- "confirmar" del mando (normalmente A) para "activar" ese
			-- elemento de UI, y el input nunca llega limpio a nuestro
			-- listener de activation binds (llega con gameProcessed=true).
			-- Esto era exactamente lo que impedía reproducir una macro
			-- después de asignarle el botón A/X del control.
			GuiService.SelectedObject = nil
		end
	end
end

ToggleButton.MouseButton1Click:Connect(togglePanel)

-- ============================================================
-- SELECCIÓN INICIAL PARA GAMEPAD
-- Sin esto, un control no tiene forma de "detectar" ningún botón:
-- Roblox solo permite navegar/activar con gamepad a partir de un
-- GuiService.SelectedObject ya establecido. Lo fijamos al abrir el
-- panel (y al conectar un control) para que la navegación funcione.
-- ============================================================

local function focusGamepadSelection()
	if not UserInputService.GamepadEnabled then return end
	if panelOpen and MainFrame.Visible then
		GuiService.SelectedObject = NewMacroButton
	else
		-- Nada seleccionado mientras el panel está cerrado: así el mando
		-- queda "libre" para que los binds de macros lleguen sin que la
		-- UI se los coma primero. Ver nota en togglePanel().
		GuiService.SelectedObject = nil
	end
end

