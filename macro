local function makeMobileButtonDraggable(button)
	if mobileDragConnections[button] then return end

	local dragging = false
	local dragStart = nil
	local startPosition = nil
	local moved = false

	local beginConnection = button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		dragging = true
		moved = false
		dragStart = input.Position
		startPosition = button.Position
	end)

	local changedConnection = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = input.Position - dragStart
		if math.abs(delta.X) + math.abs(delta.Y) > 6 then
			moved = true
		end

		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
		local size = button.AbsoluteSize
		local maxX = math.max(0, viewport.X - size.X - 8)
		local maxY = math.max(0, viewport.Y - size.Y - 8)

		local newX = math.clamp(startPosition.X.Offset + delta.X, 8, maxX)
		local newY = math.clamp(startPosition.Y.Offset + delta.Y, 8, maxY)

		button.Position = UDim2.new(0, newX, 0, newY)
	end)

	local endConnection = button.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = false
	end)

	mobileDragConnections[button] = {
		beginConnection,
		changedConnection,
		endConnection,
	}
end

local function createMobileMacroButton(macroName, index)
	local old = mobileMacroButtons[macroName]
	if old then
		old:Destroy()
		mobileMacroButtons[macroName] = nil
	end

	local button = Instance.new("TextButton")
	button.Name = "MobileMacro_" .. macroName
	button.Size = UDim2.new(0, 58, 0, 58)
	button.Position = UDim2.new(0, 14 + ((index - 1) % 4) * 68, 1, -84 - (math.floor((index - 1) / 4) * 68))
	button.AnchorPoint = Vector2.new(0, 1)
	button.BackgroundColor3 = Theme.Panel
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = string.sub(macroName, 1, 8)
	button.TextWrapped = true
	button.TextSize = 11
	button.Font = Theme.Font
	button.TextColor3 = Theme.Text
	button.ZIndex = 81
	button.Selectable = true
	button.Parent = MobileFloatingLayer

	applyCorner(button, 29)
	applyStroke(button, Theme.Accent, 2)

	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = button

	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), {Scale = 0.88}):Play()
	end)

	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1}):Play()
	end)

	button.MouseButton1Click:Connect(function()
		-- Si hubo arrastre, no ejecutar la macro.
		if button:GetAttribute("WasDragged") then
			button:SetAttribute("WasDragged", false)
			return
		end

		local macro = manager:GetMacro(macroName)
		if not macro or #macro.sequence == 0 or macroPlayerInstance:IsPlaying() then
			return
		end

		local original = button.BackgroundColor3
		TweenService:Create(button, TweenInfo.new(0.12), {
			BackgroundColor3 = Theme.Accent
		}):Play()

		task.delay(0.16, function()
			if button.Parent then
				TweenService:Create(button, TweenInfo.new(0.25), {
					BackgroundColor3 = original
				}):Play()
			end
		end)

		task.spawn(function()
			macroPlayerInstance:Play(macro, player)
		end)
	end)

	-- Marca el botón si el desplazamiento supera el umbral.
	local dragStartPosition = nil
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragStartPosition = input.Position
		end
	end)

	button.InputChanged:Connect(function(input)
		if not dragStartPosition then return end
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStartPosition
			if math.abs(delta.X) + math.abs(delta.Y) > 8 then
				button:SetAttribute("WasDragged", true)
			end
		end
	end)

	makeMobileButtonDraggable(button)
	mobileMacroButtons[macroName] = button
end

function refreshMobileMacroButtons()
	if not isMobile or quickButtonsHidden then
		MobileFloatingLayer.Visible = false
		return
	end

	MobileFloatingLayer.Visible = true

	local names = {}
	for _, row in ipairs(MacroListContainer:GetChildren()) do
		if row:IsA("Frame") and row.Name ~= "" then
			local macro = manager:GetMacro(row.Name)
			if macro and (macro.quickButtonEnabled or macro.activationBind) then
				table.insert(names, row.Name)
			end
		end
	end
	table.sort(names)

	local active = {}
	for index, macroName in ipairs(names) do
		active[macroName] = true
		local existing = mobileMacroButtons[macroName]

		if existing then
			-- Conserva la posición si el usuario ya lo movió.
			existing.Visible = true
		else
			createMobileMacroButton(macroName, index)
		end
	end

	for macroName, button in pairs(mobileMacroButtons) do
		if not active[macroName] then
			button:Destroy()
			mobileMacroButtons[macroName] = nil
		end
	end
end

