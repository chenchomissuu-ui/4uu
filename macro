-- ============================================================
-- MÓDULOS INTERNOS
-- Antes eran ModuleScripts separados en ReplicatedStorage.MacroSystem.
-- Solo este script los usaba, así que ahora son locales aquí mismo.
-- (Ojo: si en el futuro otro script necesita compartir ActionRegistry
-- o Recorder, deben volver a ser ModuleScripts reales — ver nota abajo).
-- ============================================================

-- ----- MacroData -----
local MacroData = {}
function MacroData.new(name)
	return {
		name = name,
		activationBind = nil,
		sequence = {},
	}
end

-- ----- Recorder -----
local Recorder = {}
Recorder.__index = Recorder

function Recorder.new()
	local self = setmetatable({}, Recorder)
	self._recording = false
	self._sequence = {}
	self._lastTime = 0
	return self
end

function Recorder:IsRecording()
	return self._recording
end

function Recorder:Start()
	if self._recording then
		warn("[Recorder] Ya se está grabando.")
		return
	end
	self._recording = true
	self._sequence = {}
	self._lastTime = os.clock()
end

function Recorder:Stop(): {any}
	self._recording = false
	return self._sequence
end

function Recorder:_Capture(actionName: string)
	if not self._recording then return end
	local now = os.clock()
	local delay = now - self._lastTime
	self._lastTime = now
	table.insert(self._sequence, {
		action = actionName,
		delay = delay,
	})
end

-- ----- ActionRegistry -----
local ActionRegistry = {}
local registeredActions = {}
local activeRecorder = nil

function ActionRegistry.Register(name, callback)
	if registeredActions[name] then
		warn("[ActionRegistry] La acción '" .. name .. "' ya estaba registrada, se sobreescribe.")
	end
	registeredActions[name] = callback
end

function ActionRegistry.SetActiveRecorder(recorderInstance)
	activeRecorder = recorderInstance
end

function ActionRegistry.Execute(name: string, plr: Player, fromInput: boolean?)
	local action = registeredActions[name]
	if not action then
		warn("[ActionRegistry] Acción no encontrada: " .. tostring(name))
		return
	end
	if fromInput and activeRecorder then
		activeRecorder:_Capture(name)
	end
	action(plr, fromInput)
end

function ActionRegistry.IsRegistered(name: string): boolean
	return registeredActions[name] ~= nil
end

-- ----- MacroManager -----
local MacroManager = {}
MacroManager.__index = MacroManager

function MacroManager.new()
	local self = setmetatable({}, MacroManager)
	self._macros = {}
	return self
end

function MacroManager:CreateMacro(name: string)
	if self._macros[name] then
		warn("[MacroManager] Ya existía una macro llamada '" .. name .. "', se sobreescribe.")
	end
	local macro = MacroData.new(name)
	self._macros[name] = macro
	return macro
end

function MacroManager:DeleteMacro(name: string)
	if not self._macros[name] then
		warn("[MacroManager] No existe una macro llamada '" .. name .. "'.")
		return
	end
	self._macros[name] = nil
end

function MacroManager:GetMacro(name: string)
	return self._macros[name]
end

function MacroManager:GetAllMacros()
	local list = {}
	for _, macro in pairs(self._macros) do
		table.insert(list, macro)
	end
	return list
end

function MacroManager:SetActivationBind(name: string, keyCode: Enum.KeyCode)
	local macro = self._macros[name]
	if not macro then
		warn("[MacroManager] No existe una macro llamada '" .. name .. "'.")
		return
	end
	for otherName, otherMacro in pairs(self._macros) do
		if otherName ~= name and otherMacro.activationBind == keyCode then
			warn("[MacroManager] La tecla ya está asignada a la macro '" .. otherName .. "'. Se quita de ahí.")
			otherMacro.activationBind = nil
		end
	end
	macro.activationBind = keyCode
end

function MacroManager:GetMacroByBind(keyCode: Enum.KeyCode)
	for _, macro in pairs(self._macros) do
		if macro.activationBind == keyCode then
			return macro
		end
	end
	return nil
end

-- ----- MacroPlayer -----
local MacroPlayer = {}
MacroPlayer.__index = MacroPlayer

function MacroPlayer.new()
	local self = setmetatable({}, MacroPlayer)
	self._playing = false
	self._stopRequested = false
	return self
end

function MacroPlayer:IsPlaying(): boolean
	return self._playing
end

function MacroPlayer:Stop()
	self._stopRequested = true
end

function MacroPlayer:Play(macro, plr: Player)
	if self._playing then
		warn("[MacroPlayer] Ya hay una macro reproduciéndose.")
		return
	end

	self._playing = true
	self._stopRequested = false

	for _, step in ipairs(macro.sequence) do
		if self._stopRequested then break end
		if step.delay and step.delay > 0 then
			task.wait(step.delay)
		end
		if self._stopRequested then break end
		ActionRegistry.Execute(step.action, plr)
	end

	self._playing = false
	self._stopRequested = false
end

