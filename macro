local function friendlyStepLabel(actionName)
	if actionName == "Wait" then
		return "Wait"
	elseif actionName:sub(1, 9) == "EquipSlot" then
		local num = actionName:match("EquipSlot(%d+)")
		return "Slot " .. (num or "?")
	elseif actionName:sub(1, 10) == "EquipTool:" then
		return "Equip " .. actionName:sub(11)
	elseif actionName == "ToolAttack" then
		return "Fire"
	end
	return actionName
end

local function friendlyStepColor(actionName)
	if actionName == "Wait" then
		return Theme.SubText
	elseif actionName == "ToolAttack" then
		return Theme.Danger
	elseif actionName:sub(1, 9) == "EquipSlot" then
		return Theme.Accent
	elseif actionName:sub(1, 10) == "EquipTool:" then
		return Theme.Success
	end
	return Theme.Cyan
end

local function friendlyStepIcon(actionName)
	if actionName == "Wait" then
		return "⏱"
	elseif actionName == "ToolAttack" then
		return "F"
	elseif actionName:sub(1, 9) == "EquipSlot" then
		return actionName:match("EquipSlot(%d+)") or "S"
	elseif actionName:sub(1, 10) == "EquipTool:" then
		return "E"
	end
	return "•"
end

local function buildSequenceSummary(macro)
	if #macro.sequence == 0 then
		return "No steps yet — press EDIT"
	end
	local parts = {}
	for i, step in ipairs(macro.sequence) do
		if i > 1 and step.delay and step.delay > 0.01 then
			table.insert(parts, string.format("%.2gs", step.delay))
		end
		table.insert(parts, friendlyStepLabel(step.action))
	end
	local text = table.concat(parts, " › ")
	if #text > 64 then
		text = text:sub(1, 61) .. "..."
	end
	return text
end

