local function applyCorner(inst, radiusPx)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radiusPx or 8)
	c.Parent = inst
	return c
end

local function applyStroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Accent
	s.Thickness = thickness or 1.5
	s.Transparency = transparency or 0
	s.Parent = inst
	return s
end

local function styleButton(btn, variant)
	variant = variant or "secondary"

	local baseColor = Theme.RowAlt
	local strokeColor = Theme.Accent
	if variant == "primary" then
		baseColor = Theme.Accent
		strokeColor = Color3.fromRGB(220, 180, 255)
	elseif variant == "danger" then
		baseColor = Color3.fromRGB(45, 22, 30)
		strokeColor = Theme.Danger
	end

	btn.Font = Theme.FontRegular
	btn.TextColor3 = Theme.Text
	btn.TextScaled = false
	btn.TextSize = 15
	btn.BackgroundColor3 = baseColor
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	applyCorner(btn, 6)
	applyStroke(btn, strokeColor, 1.3)

	local originalSize = btn.Size
	local hoverColor = baseColor:Lerp(Color3.new(1, 1, 1), 0.12)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = hoverColor}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = baseColor}):Play()
		TweenService:Create(btn, TweenInfo.new(0.1), {Size = originalSize}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.07), {
			Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 4, originalSize.Y.Scale, originalSize.Y.Offset - 4)
		}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {Size = originalSize}):Play()
	end)
end

local function styleFrame(frame, bgColor)
	frame.BackgroundColor3 = bgColor or Theme.Panel
	frame.BorderSizePixel = 0
	applyCorner(frame, 10)
end

local function styleLabel(label, big)
	label.Font = big and Theme.Font or Theme.FontRegular
	label.TextColor3 = Theme.Text
	label.TextSize = big and 18 or 14
end

local function styleTextBox(box)
	box.Font = Theme.FontRegular
	box.TextColor3 = Theme.Text
	box.PlaceholderColor3 = Theme.SubText
	box.BackgroundColor3 = Theme.RowAlt
	box.BorderSizePixel = 0
	box.TextSize = 14
	applyCorner(box, 6)
	applyStroke(box, Theme.Accent, 1)
end

