	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

	if isMobile then
		responsiveScale.Scale = math.clamp(math.min(viewport.X / 420, viewport.Y / 760), 0.72, 0.98)
		MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		responsiveScale.Scale = math.clamp(math.min(viewport.X / 1000, viewport.Y / 700), 0.82, 1)
	else
		responsiveScale.Scale = math.clamp(math.min(viewport.X / 1100, viewport.Y / 760), 0.78, 1)
	end
end

