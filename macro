	bindButton.Parent = keyRow
	styleButton(bindButton, "secondary")

	local clearBindButton = Instance.new("TextButton")
	clearBindButton.Size = UDim2.new(0, 46, 1, 0)
	clearBindButton.Position = UDim2.new(1, -46, 0, 0)
	clearBindButton.Text = "CLR"
	clearBindButton.Parent = keyRow
	styleButton(clearBindButton, "danger")

	local waitingForBind = false

	bindButton.MouseButton1Click:Connect(function()
		if waitingForBind then return end
		waitingForBind = true
		bindButton.Text = "..."

		local connection
		connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if input.UserInputType ~= Enum.UserInputType.Keyboard
				and input.UserInputType ~= Enum.UserInputType.Gamepad1 then
				return
			end

			manager:SetActivationBind(macro.name, input.KeyCode)
			keyLabel.Text = "Bound to " .. input.KeyCode.Name
			bindButton.Text = "Set Key"
			waitingForBind = false
			connection:Disconnect()
			refreshQuickButton(macro)
		end)
	end)

	clearBindButton.MouseButton1Click:Connect(function()
		macro.activationBind = nil
		keyLabel.Text = "No key set - runs from RUN or its bound key"
		refreshQuickButton(macro)
	end)

	-- EDIT abre el panel independiente "Editing: [macro]"
	editButton.MouseButton1Click:Connect(function()
		openEditPanel(macro)
	end)

	recordButton.MouseButton1Click:Connect(function()
		if currentlyRecordingMacro == macro.name then
			local result = sharedRecorder:Stop()
			macro.sequence = result
			currentlyRecordingMacro = nil
			setButtonVariant(recordButton, "danger")
			subtitleLabel.Text = buildSequenceSummary(macro)
			if currentEditingMacro == macro then
				refreshEditPanelSteps()
			end
		elseif currentlyRecordingMacro == nil then
			sharedRecorder:Start()
			currentlyRecordingMacro = macro.name
			setButtonVariant(recordButton, "success")
		end
	end)

	playButton.MouseButton1Click:Connect(function()
		if #macro.sequence == 0 then return end
		if macroPlayerInstance:IsPlaying() then return end
		task.spawn(function()
			macroPlayerInstance:Play(macro, player)
		end)
	end)

	quickToggleButton.MouseButton1Click:Connect(function()
		macro.quickButtonEnabled = not macro.quickButtonEnabled
		setButtonVariant(quickToggleButton, macro.quickButtonEnabled and "success" or "secondary")
		refreshQuickButton(macro)
	end)

	deleteButton.MouseButton1Click:Connect(function()
		manager:DeleteMacro(macro.name)
		if quickButtons[macro.name] then
			quickButtons[macro.name]:Destroy()
			quickButtons[macro.name] = nil
		end
		rowIndex[macro.name] = nil
		if currentEditingMacro == macro then
			closeEditPanel()
		end
		row:Destroy()
	end)

	rowIndex[macro.name] = subtitleLabel
	row.Parent = MacroListContainer
end

